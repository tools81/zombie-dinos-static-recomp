#include <winver.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Zombie Dinos from Planet Zeltoid (CD-i recompilation)"
      VALUE "ProductVersion", APP_VERSION
      VALUE "FileVersion", APP_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
